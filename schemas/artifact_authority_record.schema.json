{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArtifactAuthorityRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_type", "authority_level"],
  "properties": {
    "artifact_id": { "type": "string", "minLength": 1 },
    "path": { "type": ["string", "null"] },
    "artifact_type": { "type": "string", "minLength": 1 },
    "authority_level": { "type": "string", "minLength": 1 },
    "status": { "type": ["string", "null"] },
    "ref_id": { "type": ["string", "null"] },
    "target_id": { "type": ["string", "null"] },
    "approval_id": { "type": ["string", "null"] },
    "source_hash": { "type": ["string", "null"] },
    "risk_flags": { "type": "array", "items": { "type": "string" } },
    "metadata": { "type": "object" }
  }
}
