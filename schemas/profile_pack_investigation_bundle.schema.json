{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfilePackInvestigationBundleResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "status",
    "bundle_id",
    "profile_id",
    "finding_code",
    "readiness_path",
    "readiness_hash",
    "readiness_status",
    "drilldown_path",
    "drilldown_hash",
    "drilldown_status",
    "readiness_finding_count",
    "drilldown_item_count",
    "bundle_item_count",
    "matched_count",
    "missing_artifact_count",
    "unmatched_count",
    "high_count",
    "medium_count",
    "low_count",
    "human_review_missing_count",
    "human_review_supplied_count",
    "official_source_check_count",
    "artifacts",
    "items",
    "markdown_path",
    "json_path",
    "warnings"
  ],
  "properties": {
    "root": {"type": "string"},
    "status": {"type": "string"},
    "bundle_id": {"type": "string"},
    "profile_id": {"type": ["string", "null"]},
    "finding_code": {"type": ["string", "null"]},
    "readiness_path": {"type": "string"},
    "readiness_hash": {"type": ["string", "null"]},
    "readiness_status": {"type": ["string", "null"]},
    "drilldown_path": {"type": "string"},
    "drilldown_hash": {"type": ["string", "null"]},
    "drilldown_status": {"type": ["string", "null"]},
    "readiness_finding_count": {"type": "integer", "minimum": 0},
    "drilldown_item_count": {"type": "integer", "minimum": 0},
    "bundle_item_count": {"type": "integer", "minimum": 0},
    "matched_count": {"type": "integer", "minimum": 0},
    "missing_artifact_count": {"type": "integer", "minimum": 0},
    "unmatched_count": {"type": "integer", "minimum": 0},
    "high_count": {"type": "integer", "minimum": 0},
    "medium_count": {"type": "integer", "minimum": 0},
    "low_count": {"type": "integer", "minimum": 0},
    "human_review_missing_count": {"type": "integer", "minimum": 0},
    "human_review_supplied_count": {"type": "integer", "minimum": 0},
    "official_source_check_count": {"type": "integer", "minimum": 0},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "markdown_path": {"type": ["string", "null"]},
    "json_path": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_type", "path", "exists", "sha256", "status", "item_count", "warning"],
      "properties": {
        "artifact_type": {"type": "string"},
        "path": {"type": "string"},
        "exists": {"type": "boolean"},
        "sha256": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "item_count": {"type": "integer", "minimum": 0},
        "warning": {"type": ["string", "null"]}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundle_item_id",
        "profile_id",
        "finding_code",
        "severity",
        "readiness_message",
        "readiness_path",
        "readiness_suggested_action",
        "drilldown_id",
        "drilldown_match_status",
        "source_artifact",
        "source_artifact_path",
        "source_artifact_hash",
        "source_ref_id",
        "source_code",
        "source_status",
        "source_message",
        "source_path",
        "related_ids",
        "command",
        "human_review_status",
        "human_review_ref_id",
        "human_review_decision",
        "human_review_reviewer",
        "human_review_reviewed_at",
        "requires_human_review",
        "requires_official_source_check",
        "next_step"
      ],
      "properties": {
        "bundle_item_id": {"type": "string"},
        "profile_id": {"type": ["string", "null"]},
        "finding_code": {"type": "string"},
        "severity": {"type": "string"},
        "readiness_message": {"type": "string"},
        "readiness_path": {"type": ["string", "null"]},
        "readiness_suggested_action": {"type": ["string", "null"]},
        "drilldown_id": {"type": ["string", "null"]},
        "drilldown_match_status": {"type": ["string", "null"]},
        "source_artifact": {"type": ["string", "null"]},
        "source_artifact_path": {"type": ["string", "null"]},
        "source_artifact_hash": {"type": ["string", "null"]},
        "source_ref_id": {"type": ["string", "null"]},
        "source_code": {"type": ["string", "null"]},
        "source_status": {"type": ["string", "null"]},
        "source_message": {"type": ["string", "null"]},
        "source_path": {"type": ["string", "null"]},
        "related_ids": {"type": "array", "items": {"type": "string"}},
        "command": {"type": ["string", "null"]},
        "human_review_status": {"type": "string"},
        "human_review_ref_id": {"type": ["string", "null"]},
        "human_review_decision": {"type": ["string", "null"]},
        "human_review_reviewer": {"type": ["string", "null"]},
        "human_review_reviewed_at": {"type": ["string", "null"]},
        "requires_human_review": {"type": "boolean"},
        "requires_official_source_check": {"type": "boolean"},
        "next_step": {"type": ["string", "null"]}
      }
    }
  }
}
