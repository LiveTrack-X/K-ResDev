{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfilePackReadinessResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "status",
    "profile_count",
    "ready_count",
    "needs_review_count",
    "blocked_count",
    "profile_without_findings_count",
    "finding_count",
    "high_count",
    "medium_count",
    "low_count",
    "profiles",
    "findings",
    "markdown_path",
    "json_path",
    "warnings"
  ],
  "properties": {
    "root": {"type": "string"},
    "status": {"type": "string"},
    "profile_count": {"type": "integer", "minimum": 0},
    "ready_count": {"type": "integer", "minimum": 0},
    "needs_review_count": {"type": "integer", "minimum": 0},
    "blocked_count": {"type": "integer", "minimum": 0},
    "profile_without_findings_count": {"type": "integer", "minimum": 0},
    "finding_count": {"type": "integer", "minimum": 0},
    "high_count": {"type": "integer", "minimum": 0},
    "medium_count": {"type": "integer", "minimum": 0},
    "low_count": {"type": "integer", "minimum": 0},
    "profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "markdown_path": {"type": ["string", "null"]},
    "json_path": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "status",
        "profile_status",
        "queue_item_count",
        "fix_action_count",
        "fix_review_record_count",
        "fix_review_unresolved_count",
        "profile_review_status",
        "profile_review_can_promote",
        "promotion_status",
        "promotion_record_count",
        "latest_promotion_decision",
        "apply_status",
        "apply_can_apply",
        "apply_applied",
        "revoke_status",
        "revoke_can_revoke",
        "revoke_revoked",
        "lifecycle_status",
        "finding_count",
        "high_count",
        "medium_count",
        "low_count",
        "blockers",
        "warnings"
      ],
      "properties": {
        "profile_id": {"type": "string"},
        "status": {"type": "string"},
        "profile_status": {"type": ["string", "null"]},
        "queue_item_count": {"type": "integer", "minimum": 0},
        "fix_action_count": {"type": "integer", "minimum": 0},
        "fix_review_record_count": {"type": "integer", "minimum": 0},
        "fix_review_unresolved_count": {"type": "integer", "minimum": 0},
        "profile_review_status": {"type": ["string", "null"]},
        "profile_review_can_promote": {"type": "boolean"},
        "promotion_status": {"type": ["string", "null"]},
        "promotion_record_count": {"type": "integer", "minimum": 0},
        "latest_promotion_decision": {"type": ["string", "null"]},
        "apply_status": {"type": ["string", "null"]},
        "apply_can_apply": {"type": "boolean"},
        "apply_applied": {"type": "boolean"},
        "revoke_status": {"type": ["string", "null"]},
        "revoke_can_revoke": {"type": "boolean"},
        "revoke_revoked": {"type": "boolean"},
        "lifecycle_status": {"type": ["string", "null"]},
        "finding_count": {"type": "integer", "minimum": 0},
        "high_count": {"type": "integer", "minimum": 0},
        "medium_count": {"type": "integer", "minimum": 0},
        "low_count": {"type": "integer", "minimum": 0},
        "blockers": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message", "profile_id", "path", "suggested_action"],
      "properties": {
        "code": {"type": "string"},
        "severity": {"type": "string"},
        "message": {"type": "string"},
        "profile_id": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "suggested_action": {"type": ["string", "null"]}
      }
    }
  }
}
