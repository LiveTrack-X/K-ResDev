{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfilePromotionSummaryResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["root", "status", "record_count", "records"],
  "properties": {
    "root": {"type": "string"},
    "status": {"type": "string"},
    "profile_id": {"type": ["string", "null"]},
    "record_count": {"type": "integer", "minimum": 0},
    "verified_count": {"type": "integer", "minimum": 0},
    "latest_promotion_id": {"type": ["string", "null"]},
    "latest_decision": {"type": ["string", "null"]},
    "latest_reviewer": {"type": ["string", "null"]},
    "latest_reviewed_at": {"type": ["string", "null"]},
    "current_profile_review_hash": {"type": ["string", "null"]},
    "hash_mismatch_count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "promotion_id",
          "profile_id",
          "decision",
          "reviewer",
          "reviewed_at",
          "profile_review_path",
          "profile_review_hash",
          "profile_review_status",
          "profile_review_can_promote",
          "risk_flags"
        ],
        "properties": {
          "promotion_id": {"type": "string"},
          "profile_id": {"type": "string"},
          "decision": {"type": "string", "enum": ["verified", "rejected", "needs_changes", "revoked"]},
          "reviewer": {"type": "string"},
          "reviewed_at": {"type": "string"},
          "profile_review_path": {"type": "string"},
          "profile_review_hash": {"type": "string"},
          "profile_review_status": {"type": "string"},
          "profile_review_can_promote": {"type": "boolean"},
          "notes": {"type": ["string", "null"]},
          "risk_flags": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "markdown_path": {"type": ["string", "null"]},
    "json_path": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
