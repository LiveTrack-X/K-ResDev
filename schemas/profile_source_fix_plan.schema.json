{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileSourceFixPlanResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "status",
    "queue_path",
    "queue_hash",
    "queue_status",
    "queue_item_count",
    "profile_count",
    "action_count",
    "command_count",
    "manual_count",
    "human_review_count",
    "official_source_check_count",
    "high_count",
    "medium_count",
    "low_count",
    "actions",
    "markdown_path",
    "json_path",
    "warnings"
  ],
  "properties": {
    "root": {"type": "string"},
    "status": {
      "type": "string",
      "enum": ["missing_queue", "unreadable_queue", "blocked", "needs_review", "ready_with_notes", "ready"]
    },
    "queue_path": {"type": "string"},
    "queue_hash": {"type": ["string", "null"]},
    "queue_status": {"type": ["string", "null"]},
    "queue_item_count": {"type": "integer", "minimum": 0},
    "profile_count": {"type": "integer", "minimum": 0},
    "action_count": {"type": "integer", "minimum": 0},
    "command_count": {"type": "integer", "minimum": 0},
    "manual_count": {"type": "integer", "minimum": 0},
    "human_review_count": {"type": "integer", "minimum": 0},
    "official_source_check_count": {"type": "integer", "minimum": 0},
    "high_count": {"type": "integer", "minimum": 0},
    "medium_count": {"type": "integer", "minimum": 0},
    "low_count": {"type": "integer", "minimum": 0},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action_id",
          "queue_id",
          "scope",
          "profile_id",
          "source_id",
          "issue_code",
          "severity",
          "action_type",
          "title",
          "rationale",
          "manual_step",
          "command",
          "followup_commands",
          "source_record_path",
          "source_file",
          "requires_human_review",
          "requires_official_source_check"
        ],
        "properties": {
          "action_id": {"type": "string"},
          "queue_id": {"type": ["string", "null"]},
          "scope": {"type": ["string", "null"]},
          "profile_id": {"type": ["string", "null"]},
          "source_id": {"type": ["string", "null"]},
          "issue_code": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "action_type": {"type": "string", "enum": ["manual", "command", "manual_then_command"]},
          "title": {"type": "string"},
          "rationale": {"type": "string"},
          "manual_step": {"type": ["string", "null"]},
          "command": {"type": ["string", "null"]},
          "followup_commands": {"type": "array", "items": {"type": "string"}},
          "source_record_path": {"type": ["string", "null"]},
          "source_file": {"type": ["string", "null"]},
          "requires_human_review": {"type": "boolean"},
          "requires_official_source_check": {"type": "boolean"}
        }
      }
    },
    "markdown_path": {"type": ["string", "null"]},
    "json_path": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
