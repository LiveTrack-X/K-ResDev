{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileSourceFixPlanAction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action_id",
    "queue_id",
    "scope",
    "profile_id",
    "source_id",
    "issue_code",
    "severity",
    "action_type",
    "title",
    "rationale",
    "manual_step",
    "command",
    "followup_commands",
    "source_record_path",
    "source_file",
    "requires_human_review",
    "requires_official_source_check"
  ],
  "properties": {
    "action_id": {"type": "string"},
    "queue_id": {"type": ["string", "null"]},
    "scope": {"type": ["string", "null"]},
    "profile_id": {"type": ["string", "null"]},
    "source_id": {"type": ["string", "null"]},
    "issue_code": {"type": "string"},
    "severity": {"type": "string", "enum": ["high", "medium", "low"]},
    "action_type": {"type": "string", "enum": ["manual", "command", "manual_then_command"]},
    "title": {"type": "string"},
    "rationale": {"type": "string"},
    "manual_step": {"type": ["string", "null"]},
    "command": {"type": ["string", "null"]},
    "followup_commands": {"type": "array", "items": {"type": "string"}},
    "source_record_path": {"type": ["string", "null"]},
    "source_file": {"type": ["string", "null"]},
    "requires_human_review": {"type": "boolean"},
    "requires_official_source_check": {"type": "boolean"}
  }
}
