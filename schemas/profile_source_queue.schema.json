{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProfileSourceQueueResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "root",
    "status",
    "profile_count",
    "template_profile_count",
    "workspace_profile_count",
    "source_count",
    "queue_item_count",
    "high_count",
    "medium_count",
    "low_count",
    "items",
    "warnings"
  ],
  "properties": {
    "root": {"type": "string"},
    "status": {"type": "string"},
    "templates_root": {"type": ["string", "null"]},
    "profile_count": {"type": "integer", "minimum": 0},
    "template_profile_count": {"type": "integer", "minimum": 0},
    "workspace_profile_count": {"type": "integer", "minimum": 0},
    "source_count": {"type": "integer", "minimum": 0},
    "queue_item_count": {"type": "integer", "minimum": 0},
    "high_count": {"type": "integer", "minimum": 0},
    "medium_count": {"type": "integer", "minimum": 0},
    "low_count": {"type": "integer", "minimum": 0},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue_id",
          "scope",
          "profile_id",
          "issue_code",
          "severity",
          "message",
          "risk_flags"
        ],
        "properties": {
          "queue_id": {"type": "string"},
          "scope": {"type": "string", "enum": ["template", "workspace"]},
          "profile_id": {"type": "string"},
          "profile_status": {"type": ["string", "null"]},
          "profile_path": {"type": ["string", "null"]},
          "source_id": {"type": ["string", "null"]},
          "source_title": {"type": ["string", "null"]},
          "source_status": {"type": ["string", "null"]},
          "source_url": {"type": ["string", "null"]},
          "source_file": {"type": ["string", "null"]},
          "source_record_path": {"type": ["string", "null"]},
          "issue_code": {"type": "string"},
          "severity": {"type": "string", "enum": ["high", "medium", "low"]},
          "message": {"type": "string"},
          "suggested_action": {"type": ["string", "null"]},
          "risk_flags": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "markdown_path": {"type": ["string", "null"]},
    "json_path": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
