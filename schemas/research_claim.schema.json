{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchClaim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim",
    "claim_type",
    "evidence_ids",
    "citation_keys",
    "bibliography_ids",
    "support_ids",
    "insight_ids",
    "status",
    "confidence",
    "risk_flags",
    "next_checks"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string",
      "minLength": 1,
      "default": "research"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "citation_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "bibliography_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "support_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "insight_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "hypothesis",
        "candidate",
        "needs_review",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "unknown"
      ]
    },
    "risk_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "next_checks": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
