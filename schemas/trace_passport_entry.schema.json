{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TracePassportEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checkpoint_id",
    "created_at",
    "stage",
    "summary",
    "artifact_paths",
    "artifact_hashes",
    "unresolved_findings",
    "pending_human_decisions",
    "status"
  ],
  "properties": {
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "artifact_paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "unresolved_findings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "pending_human_decisions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "resume_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_review",
        "accepted",
        "superseded"
      ]
    }
  }
}
