{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WorkspaceWeeklyReviewResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["root", "review_date", "status"],
  "properties": {
    "root": { "type": "string", "minLength": 1 },
    "review_date": { "type": "string", "format": "date" },
    "status": { "type": "string", "minLength": 1 },
    "evidence_count": { "type": "integer", "minimum": 0 },
    "report_count": { "type": "integer", "minimum": 0 },
    "approval_count": { "type": "integer", "minimum": 0 },
    "action_count": { "type": "integer", "minimum": 0 },
    "high_action_count": { "type": "integer", "minimum": 0 },
    "objective_count": { "type": "integer", "minimum": 0 },
    "deadline_count": { "type": "integer", "minimum": 0 },
    "due_soon_count": { "type": "integer", "minimum": 0 },
    "overdue_count": { "type": "integer", "minimum": 0 },
    "open_finding_count": { "type": "integer", "minimum": 0 },
    "high_finding_count": { "type": "integer", "minimum": 0 },
    "item_count": { "type": "integer", "minimum": 0 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "category", "title", "severity", "status"],
        "properties": {
          "item_id": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "severity": { "type": "string", "minLength": 1 },
          "status": { "type": "string", "minLength": 1 },
          "message": { "type": ["string", "null"] },
          "evidence_ids": { "type": "array", "items": { "type": "string" } },
          "artifact_paths": { "type": "array", "items": { "type": "string" } },
          "due_date": { "type": ["string", "null"], "format": "date" },
          "suggested_action": { "type": ["string", "null"] }
        }
      }
    },
    "markdown_path": { "type": ["string", "null"] },
    "json_path": { "type": ["string", "null"] },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
